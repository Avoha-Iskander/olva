# Copier ce fichier en .env.local et remplir les valeurs (jamais commité).
# Les valeurs se trouvent dans Supabase : Project Settings → API.
#
# Ces deux clés sont « publiques » : elles finissent dans le navigateur,
# la sécurité des données repose sur la Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://<id-du-projet>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
