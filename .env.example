# Copier ce fichier en .env.local et remplir les valeurs (jamais commité).
# Les valeurs se trouvent dans Supabase : Project Settings → API.
#
# Ces deux clés sont « publiques » : elles finissent dans le navigateur,
# la sécurité des données repose sur la Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://<id-du-projet>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Import de recettes par photo (lot 5) — CÔTÉ SERVEUR UNIQUEMENT ---
# Clé de l'API Claude (console.anthropic.com → API Keys). Secrète : jamais
# préfixée NEXT_PUBLIC_, jamais commitée ; dans Vercel, type « Secret ».
ANTHROPIC_API_KEY=
# Modèle de production (facultatif, défaut : claude-haiku-5-5).
# Valeurs possibles : claude-haiku-5-5, claude-sonnet-5-5
OLVA_AI_MODEL=
